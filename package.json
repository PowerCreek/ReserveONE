{
  "name": "host-seating-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node build.mjs",
    "dev": "WATCH=1 node build.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:smoke": "node smoke.mjs",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:smoke",
    "v2:check": "tsc -p v2/tsconfig.json",
    "v2:build": "node v2/build.mjs",
    "v2:test": "node --test \"v2/**/*.test.ts\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.1.18",
    "typescript": "7.0.2"
  }
}
